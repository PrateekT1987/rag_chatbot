# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# The browser never sees these values — only the backend uses them.
# ---------------------------------------------------------------------------

# --- LLM (any OpenAI-compatible provider) ---------------------------------
# Required for natural-language answers. Without a key the bot still works
# but replies by listing matching catalog products.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
# For production, use a paid model with an SLA — free-tier models are
# rate-limited and can be withdrawn at any time.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
# Max tokens per generated answer (caps latency and cost).
LLM_MAX_TOKENS=400
# Retries for transient LLM failures (429 / 5xx / network).
LLM_MAX_RETRIES=2

# --- Catalog ---------------------------------------------------------------
# Path to the product CSV. Edit the CSV any time — changes are picked up
# automatically (no restart needed).
CATALOG_PATH=data/products.csv

# --- Retrieval -------------------------------------------------------------
# "tfidf" (default, zero infrastructure) or "openai" (embeddings API).
RETRIEVER=tfidf
TOP_K=4
# Minimum similarity to answer at all; below this the bot falls back instead
# of letting the LLM guess. Range 0.05-0.20, default 0.10.
RELEVANCE_THRESHOLD=0.10

# --- Server ----------------------------------------------------------------
# Comma-separated site origins allowed to call the API, e.g.
# https://www.yourstore.com,https://yourstore.com
# Leave empty if the widget is embedded on the same origin as this backend.
# For production, NEVER use "*" — any website could spend your LLM credits.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
# If set, POST /api/reindex requires this value in the X-Admin-Token header.
# If unset, reindex is allowed from localhost only.
ADMIN_TOKEN=
# Extra sentence appended to fallback answers, e.g.
# "email sales@example.com or call +1 555 0100".
FALLBACK_CONTACT=
HOST=0.0.0.0
PORT=8000
